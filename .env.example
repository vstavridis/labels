# ---------------------------------------------------------------------------
# VS Production Manager configuration. Copy to .env and edit.
# Never commit the real .env file.
# Relative paths are resolved from the project folder.
# ---------------------------------------------------------------------------

# --- General -----------------------------------------------------------------
VSPM_LANGUAGE=el                      # el | en
VSPM_TIMEZONE=Europe/Athens
VSPM_DATA_DIR=data                    # SQLite DB, logs, previews, backups
VSPM_OPERATOR_NAME=                   # shown in audit history
VSPM_COMPUTER_NAME=                   # defaults to this computer's host name
VSPM_LOG_LEVEL=INFO

# --- Google Drive (scanned documents) -----------------------------------------
VSPM_DRIVE_MODE=local                 # google | local (folder on disk) | mock
VSPM_DRIVE_FOLDER_ID=                 # ID from the Drive folder URL
VSPM_GOOGLE_AUTH=service_account      # service_account | oauth
VSPM_GOOGLE_CREDENTIALS_FILE=credentials/google_service_account.json
VSPM_GOOGLE_TOKEN_FILE=credentials/google_token.json   # oauth only
VSPM_LOCAL_SCAN_DIR=reference_files/scans              # used when DRIVE_MODE=local

# --- AI handwriting extraction ------------------------------------------------
VSPM_OCR_PROVIDER=mock                # anthropic | mock | disabled
VSPM_OCR_MODEL=claude-opus-5-5
VSPM_OCR_EFFORT=high                  # low | medium | high | xhigh | max
VSPM_OCR_SERVER_FALLBACKS=true        # retry declined requests on a fallback model
# Documents are only sent to the AI provider when this is explicitly true.
VSPM_OCR_UPLOAD_CONSENT=false
ANTHROPIC_API_KEY=

# --- DYMO printing --------------------------------------------------------------
VSPM_PRINTER_MODE=mock                # mock | dymo_web (Windows/macOS) | cups (macOS/Linux) | dymo_com (Windows, legacy)
VSPM_PRINTER_NAME=DYMO LabelWriter Wireless
VSPM_DYMO_WEB_URL=https://127.0.0.1:41951
VSPM_DYMO_WEB_VERIFY_TLS=false        # DYMO's local service uses a self-signed certificate
VSPM_CUPS_OPTIONS=-o fit-to-page      # extra `lp` options for cups mode (e.g. -o media=w154h288)
VSPM_CUPS_ROTATE=true                 # rotate the landscape label to the feed direction
VSPM_TEMPLATES_CONFIG=config/templates.yaml
VSPM_TEMPLATE_DIR=reference_files     # where the .label files live (read-only)

# --- Barcode numbering --------------------------------------------------------
# disabled    : printing new labels is blocked (safe default)
# mock        : in-memory/test numbers, NEVER for production labels
# pilot_range : local allocation inside ranges reserved exclusively for this PC
# registry    : central barcode registry service (recommended for production)
VSPM_BARCODE_MODE=disabled
VSPM_REGISTRY_URL=http://localhost:8765
VSPM_REGISTRY_API_KEY=
# Pilot ranges, e.g. VS:900000-900999,PG:90000-90999,PG0:9000-9099,EX:90000-90999
VSPM_PILOT_RANGES=

# --- Excel (OneDrive workbook) --------------------------------------------------
# Point this at a TEST COPY until the integration checklist is complete.
VSPM_EXCEL_PATH=data/test_workbook/Σχισμενα.xlsx
VSPM_EXCEL_SHEET=΄Ετοιμα προϊόντα
# staging        : rows are queued; operator applies/reconciles them (safe default)
# direct         : this PC writes to the synchronized workbook itself
# registry_queue : rows go to the registry; one designated PC runs `vspm excel-worker`
VSPM_EXCEL_MODE=staging
VSPM_EXCEL_WRITE_ENABLED=false        # must be true before the app writes to VSPM_EXCEL_PATH
VSPM_EXCEL_DATE_FORMAT=dd/mm/yyyy
VSPM_EXCEL_MATERIAL_SOURCE=canonical  # canonical (Greek, as existing rows) | label
VSPM_EXCEL_FULL_CALC_ON_LOAD=true
VSPM_EXCEL_BLOCK_ON_CONFLICT_COPIES=true
