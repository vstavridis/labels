# TEMPLATE ONLY - never put real values in the repository.
# Streamlit Community Cloud: App settings -> Secrets -> paste the filled-in content.
# Locally: copy to .streamlit/secrets.toml (git-ignored).
# Root-level keys are also exposed as environment variables, which the app reads.

# ---- shared persistent database (PostgreSQL: Neon, Supabase, ...; use sslmode=require) ----
VSPM_DATABASE_URL = "postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ---- barcodes: allocated by the shared database (initialise the series in Settings) ----
VSPM_BARCODE_MODE = "database"
VSPM_PRINTER_MODE = "browser"          # printed by the employee's browser via the local DYMO service
VSPM_DYMO_COUNTER_MODE = "sync"        # template COUNTER set to the reserved number ("remove" deletes it)
VSPM_EXCEL_MODE = "staging"            # the cloud cannot write the OneDrive workbook
VSPM_EXCEL_WRITE_ENABLED = "false"

# ---- employees who may sign in (comma-separated) ----
VSPM_ALLOWED_EMAILS = "employee1@example.com, employee2@example.com"
VSPM_ADMIN_EMAILS = "owner@example.com"

# ---- documents and AI reading ----
VSPM_DRIVE_MODE = "google"
VSPM_GOOGLE_AUTH = "service_account"
VSPM_DRIVE_FOLDER_ID = "FOLDER_ID"
VSPM_GOOGLE_CREDENTIALS_JSON = '''
{ "type": "service_account", "project_id": "...", "private_key_id": "...", "private_key": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n", "client_email": "...@....iam.gserviceaccount.com", "token_uri": "https://oauth2.googleapis.com/token" }
'''
VSPM_OCR_PROVIDER = "anthropic"
VSPM_OCR_UPLOAD_CONSENT = "true"
ANTHROPIC_API_KEY = "sk-ant-..."

VSPM_LANGUAGE = "el"
VSPM_TIMEZONE = "Europe/Athens"

# ---- employee login (Streamlit OIDC) ----
# Pick ONE provider block. redirect_uri = https://<your-app>.streamlit.app/oauth2callback
# cookie_secret: a long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
[auth]
redirect_uri = "https://YOUR-APP.streamlit.app/oauth2callback"
cookie_secret = "LONG-RANDOM-STRING"

# Google Workspace / Gmail accounts:
client_id = "....apps.googleusercontent.com"
client_secret = "..."
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# Microsoft 365 accounts instead (Entra ID app registration; replace TENANT_ID):
# client_id = "..."
# client_secret = "..."
# server_metadata_url = "https://login.microsoftonline.com/TENANT_ID/v2.0/.well-known/openid-configuration"
# client_kwargs = { "prompt" = "select_account" }
